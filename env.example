# Server
PORT=3000
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Microsoft 365 / Microsoft Graph (server-side only)
# Create an Entra ID App Registration and grant Microsoft Graph Application permission Mail.Send.
# An administrator must grant tenant-wide admin consent.
M365_TENANT_ID=YOUR_MICROSOFT_ENTRA_TENANT_ID
M365_CLIENT_ID=YOUR_APP_REGISTRATION_CLIENT_ID
M365_CLIENT_SECRET=YOUR_APP_REGISTRATION_CLIENT_SECRET
M365_SENDER_EMAIL=taskobservation@yourcompany.com
M365_SENDER_NAME=INSEE Digital Task Observation System
